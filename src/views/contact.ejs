<%- include('partials/header') %>

<main id="main-content" role="main">
    <!-- Contact Header -->
    <section class="container section-padding" style="padding-bottom: 4rem;">
        <div style="text-align: center;">
            <div style="display: inline-flex; align-items: center; justify-content: center; background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.1); color: var(--accent-cyan); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 1rem; border-radius: 999px; margin-bottom: 1.5rem;">
                Contact
            </div>
            <h1 class="reveal" style="font-size: 4rem; font-weight: 700; margin-bottom: 1.5rem; letter-spacing: -0.04em;">Let's build <span style="background: var(--gradient-tech); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">something great</span></h1>
            <p class="reveal" style="font-size: 1.125rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto; line-height: 1.6;">Tell us a bit about your project. You'll hear back within 48 hours.</p>
        </div>
    </section>

    <!-- Main Contact Grid -->
    <section class="container section-padding" style="padding-top: 0; padding-bottom: 4rem;">
        <div class="contact-grid" style="display: grid; grid-template-columns: 1fr 1.3fr; gap: 4rem; align-items: start; max-width: 1100px; margin: 0 auto;">
            
            <!-- Left Side: Stacked Contact Cards -->
            <div class="reveal" style="display: flex; flex-direction: column; gap: 1rem;">
                <!-- Email -->
                <div style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.5rem 2rem; border-radius: 16px; display: flex; align-items: center; gap: 1.5rem; transition: transform 0.3s ease; cursor: pointer; box-shadow: var(--glass-shadow);" onmouseover="this.style.transform='translateX(10px)'" onmouseout="this.style.transform='translateX(0)'">
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(14, 165, 233, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan);"><i class="fas fa-envelope"></i></div>
                    <div>
                        <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 0.25rem;">Email</div>
                        <a href="mailto:info@growthwithtech.com" style="color: var(--text-primary); font-weight: 500; font-size: 1rem; text-decoration: none;">info@growthwithtech.com</a>
                    </div>
                </div>

                <!-- Phone -->
                <div style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.5rem 2rem; border-radius: 16px; display: flex; align-items: center; gap: 1.5rem; transition: transform 0.3s ease; cursor: pointer; box-shadow: var(--glass-shadow);" onmouseover="this.style.transform='translateX(10px)'" onmouseout="this.style.transform='translateX(0)'">
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(14, 165, 233, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan);"><i class="fas fa-phone-alt"></i></div>
                    <div>
                        <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 0.25rem;">Direct Line</div>
                        <a href="tel:+919667854160" style="color: var(--text-primary); font-weight: 500; font-size: 1rem; text-decoration: none;">+91 9667854160</a>
                    </div>
                </div>

                <!-- Location -->
                <div style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.5rem 2rem; border-radius: 16px; display: flex; align-items: center; gap: 1.5rem; transition: transform 0.3s ease; cursor: pointer; box-shadow: var(--glass-shadow);" onmouseover="this.style.transform='translateX(10px)'" onmouseout="this.style.transform='translateX(0)'">
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(14, 165, 233, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan);"><i class="fas fa-map-marker-alt"></i></div>
                    <div>
                        <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 0.25rem;">HQ Location</div>
                        <div style="color: var(--text-primary); font-weight: 500; font-size: 0.95rem;">Gaur City Mall, Noida</div>
                    </div>
                </div>

                <!-- Social -->
                <div style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.5rem 2rem; border-radius: 16px; display: flex; align-items: center; gap: 1.5rem; transition: transform 0.3s ease; cursor: pointer; box-shadow: var(--glass-shadow);" onmouseover="this.style.transform='translateX(10px)'" onmouseout="this.style.transform='translateX(0)'">
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(14, 165, 233, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan);"><i class="fas fa-link"></i></div>
                    <div>
                        <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 0.25rem;">Socials</div>
                        <div style="color: var(--text-primary); font-weight: 500; font-size: 0.95rem; display: flex; gap: 0.5rem;">
                            <a href="https://www.linkedin.com/company/growth-with-tech/" style="color: inherit; text-decoration: none;"><i class="fab fa-linkedin"></i></a>
                            <a href="https://x.com/Growthwithtech" style="color: inherit; text-decoration: none;"><i class="fab fa-twitter"></i></a>
                            <a href="https://www.instagram.com/growthwith_tech/" style="color: inherit; text-decoration: none;"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Dark Form Card -->
            <div class="card reveal" style="padding: 3rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 24px;">
                <% if (successMessage) { %>
                    <div style="background: rgba(37, 211, 102, 0.1); border: 1px solid rgba(37, 211, 102, 0.3); color: #128C7E; padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 500;">
                        <i class="fas fa-check-circle"></i> <%= successMessage %>
                    </div>
                <% } %>
                
                <% if (errorMessage) { %>
                    <div style="background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.3); color: #DC2626; padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 500;">
                        <i class="fas fa-exclamation-circle"></i> <%= errorMessage %>
                    </div>
                <% } %>

                <form action="/contact" method="POST" style="display: grid; gap: 1.5rem;">
                    
                    <div class="contact-form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Name</label>
                            <input type="text" name="name" required placeholder="Your name" style="width: 100%; background: rgba(255,255,255,0.5); border: 1px solid var(--border-glass); padding: 1rem 1.25rem; border-radius: 12px; color: var(--text-primary); outline: none; transition: border 0.3s;" onfocus="this.style.border='1px solid var(--accent-cyan)'" onblur="this.style.border='1px solid var(--border-glass)'">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Email</label>
                            <input type="email" name="email" required placeholder="you@company.com" style="width: 100%; background: rgba(255,255,255,0.5); border: 1px solid var(--border-glass); padding: 1rem 1.25rem; border-radius: 12px; color: var(--text-primary); outline: none; transition: border 0.3s;" onfocus="this.style.border='1px solid var(--accent-cyan)'" onblur="this.style.border='1px solid var(--border-glass)'">
                        </div>
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Company</label>
                        <input type="text" name="company" placeholder="Company (optional)" style="width: 100%; background: rgba(255,255,255,0.5); border: 1px solid var(--border-glass); padding: 1rem 1.25rem; border-radius: 12px; color: var(--text-primary); outline: none; transition: border 0.3s;" onfocus="this.style.border='1px solid var(--accent-cyan)'" onblur="this.style.border='1px solid var(--border-glass)'">
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">What do you need help with?</label>
                        <div style="position: relative;">
                            <select name="service" style="appearance: none; width: 100%; background: rgba(255,255,255,0.5); border: 1px solid var(--border-glass); padding: 1rem 1.25rem; border-radius: 12px; color: var(--text-primary); outline: none; transition: border 0.3s; cursor: pointer;" onfocus="this.style.border='1px solid var(--accent-cyan)'" onblur="this.style.border='1px solid var(--border-glass)'">
                                <option value="AI / LLM Integration" <%= (typeof selectedService !== 'undefined' && selectedService === 'AI / LLM Integration') ? 'selected' : '' %> style="background: white; color: var(--text-primary);">AI / LLM Integration</option>
                                <option value="Web Platform / Architecture" <%= (typeof selectedService !== 'undefined' && selectedService === 'Web Platform / Architecture') ? 'selected' : '' %> style="background: white; color: var(--text-primary);">Web Platform / Architecture</option>
                                <option value="Headless E-commerce" <%= (typeof selectedService !== 'undefined' && selectedService === 'Headless E-commerce') ? 'selected' : '' %> style="background: white; color: var(--text-primary);">Headless E-commerce</option>
                                <option value="Growth & Analytics" <%= (typeof selectedService !== 'undefined' && selectedService === 'Growth & Analytics') ? 'selected' : '' %> style="background: white; color: var(--text-primary);">Growth & Analytics</option>
                            </select>
                            <i class="fas fa-chevron-down" style="position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--text-secondary); pointer-events: none;"></i>
                        </div>
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Project Details</label>
                        <textarea name="details" required placeholder="Tell us about your goals, timeline, and any constraints..." rows="4" style="width: 100%; background: rgba(255,255,255,0.5); border: 1px solid var(--border-glass); padding: 1rem 1.25rem; border-radius: 12px; color: var(--text-primary); outline: none; transition: border 0.3s; resize: none; font-family: inherit;" onfocus="this.style.border='1px solid var(--accent-cyan)'" onblur="this.style.border='1px solid var(--border-glass)'"></textarea>
                    </div>

                    <button type="submit" style="width: 100%; padding: 1.25rem; border: none; border-radius: 12px; background: var(--gradient-tech); color: white; font-weight: 600; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: opacity 0.3s; margin-top: 0.5rem;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                        Send message <i class="fas fa-paper-plane"></i>
                    </button>
                    
                </form>
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="container section-padding" style="padding-top: 0; padding-bottom: 6rem;">
        <div class="reveal" style="width: 100%; height: 450px; border-radius: 24px; overflow: hidden; border: 1px solid var(--border-glass); background: var(--bg-card);">
            <iframe 
                width="100%" 
                height="100%" 
                frameborder="0" 
                scrolling="no" 
                marginheight="0" 
                marginwidth="0" 
                src="https://maps.google.com/maps?q=Gaur+City+Mall,+Greater+Noida+West,+Uttar+Pradesh&t=&z=14&ie=UTF8&iwloc=&output=embed"
                style="filter: grayscale(0.2) opacity(0.8);"
            ></iframe>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

<!-- ContactPage Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "mainEntity": {
    "@id": "https://growthwithtech.com/#organization"
  },
  "description": "Contact GrowthWithTech for AI solutions, web engineering, and growth projects. We respond within 48 hours."
}
</script>
