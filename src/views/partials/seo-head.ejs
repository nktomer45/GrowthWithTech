<%
  /* Defaults — each page can override these by passing variables from the controller */
  const _title       = typeof seoTitle !== 'undefined'       ? seoTitle       : title;
  const _desc        = typeof seoDesc !== 'undefined'        ? seoDesc        : 'GrowthWithTech is a senior engineering studio delivering AI-first products, scalable web platforms, and performance-driven digital marketing for ambitious founders and product teams.';
  const _canonical   = typeof canonical !== 'undefined'      ? canonical      : 'https://growthwithtech.com' + (typeof pageUrl !== 'undefined' ? pageUrl : '');
  const _ogImage     = typeof ogImage !== 'undefined'        ? ogImage        : 'https://growthwithtech.com/images/growthwithtech.png';
  const _pageType    = typeof pageType !== 'undefined'       ? pageType       : 'website';
  const _breadcrumbs = typeof breadcrumbs !== 'undefined'    ? breadcrumbs    : null;
  const _schemaType  = typeof schemaType !== 'undefined'     ? schemaType     : 'WebPage';
%>

<!-- ═══════════════════════════════════════════ -->
<!--  PRIMARY META                              -->
<!-- ═══════════════════════════════════════════ -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<title><%= _title %></title>
<meta name="description" content="<%= _desc %>">
<meta name="keywords" content="web development, AI solutions, digital marketing, SEO, app development, software development, GrowthWithTech, Noida, India, senior engineering studio, custom chatbots, LangGraph, agentic workflows, headless commerce, Shopify Hydrogen, performance optimization">
<meta name="author" content="GrowthWithTech">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<meta name="theme-color" content="#020617">
<meta name="language" content="English">
<meta name="rating" content="General">
<meta name="referrer" content="no-referrer-when-downgrade">

<!-- Dublin Core (AI & Institutional indexing) -->
<meta name="DC.title" content="<%= _title %>">
<meta name="DC.creator" content="GrowthWithTech">
<meta name="DC.description" content="<%= _desc %>">
<meta name="DC.publisher" content="GrowthWithTech">
<meta name="DC.format" content="text/html">
<meta name="DC.language" content="en">

<!-- Canonical & Hreflang -->
<link rel="canonical" href="<%= _canonical %>">
<link rel="alternate" hreflang="en-IN" href="<%= _canonical %>">
<link rel="alternate" hreflang="x-default" href="<%= _canonical %>">
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">

<!-- ═══════════════════════════════════════════ -->
<!--  OPEN GRAPH (Facebook / LinkedIn / AI)     -->
<!-- ═══════════════════════════════════════════ -->
<meta property="og:type"               content="<%= _pageType %>">
<meta property="og:title"              content="<%= _title %>">
<meta property="og:description"        content="<%= _desc %>">
<meta property="og:url"                content="<%= _canonical %>">
<meta property="og:image"              content="<%= _ogImage %>">
<meta property="og:image:width"        content="1200">
<meta property="og:image:height"       content="630">
<meta property="og:image:alt"          content="GrowthWithTech - AI, Web & Growth Engineering">
<meta property="og:site_name"          content="GrowthWithTech">
<meta property="og:locale"             content="en_IN">

<!-- ═══════════════════════════════════════════ -->
<!--  TWITTER / X CARDS                         -->
<!-- ═══════════════════════════════════════════ -->
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:site"        content="@Growthwithtech">
<meta name="twitter:creator"     content="@Growthwithtech">
<meta name="twitter:title"       content="<%= _title %>">
<meta name="twitter:description" content="<%= _desc %>">
<meta name="twitter:image"       content="<%= _ogImage %>">

<!-- ═══════════════════════════════════════════ -->
<!--  PERFORMANCE: Resource Hints               -->
<!-- ═══════════════════════════════════════════ -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdnjs.cloudflare.com">
<link rel="dns-prefetch" href="https://www.google-analytics.com">

<!-- Favicon -->
<link rel="icon"             type="image/png" sizes="32x32" href="/images/growthwithtech.png">
<link rel="apple-touch-icon"                              href="/images/growthwithtech.png">
<link rel="manifest"                                      href="/manifest.json">

<!-- ═══════════════════════════════════════════ -->
<!--  STYLESHEETS                               -->
<!-- ═══════════════════════════════════════════ -->
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"></noscript>
<link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@300;400;500;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@300;400;500;700&display=swap"></noscript>

<!-- ═══════════════════════════════════════════ -->
<!--  JSON-LD SCHEMA: ProfessionalService (Global) -->
<!-- ═══════════════════════════════════════════ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://growthwithtech.com/#organization",
  "name": "GrowthWithTech",
  "alternateName": "Growth With Tech",
  "url": "https://growthwithtech.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://growthwithtech.com/images/growthwithtech.png",
    "width": 512,
    "height": 512
  },
  "image": "https://growthwithtech.com/images/growthwithtech.png",
  "description": "GrowthWithTech is a senior engineering studio delivering AI-first products, scalable web platforms, digital marketing, and growth systems.",
  "slogan": "Smart Solutions. Real Growth.",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "12th Floor, Gaur City Mall, Sector 4",
    "addressLocality": "Noida",
    "addressRegion": "Uttar Pradesh",
    "postalCode": "201301",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 28.6014,
    "longitude": 77.4453
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+91-9667854160",
      "contactType": "customer support",
      "availableLanguage": ["English", "Hindi"]
    }
  ],
  "sameAs": [
    "https://www.linkedin.com/company/growth-with-tech/",
    "https://x.com/Growthwithtech",
    "https://www.instagram.com/growthwith_tech/",
    "https://www.facebook.com/growthwithtech/",
    "https://www.youtube.com/@GrowthWithTech"
  ]
}
</script>

<!-- ═══════════════════════════════════════════ -->
<!--  JSON-LD SCHEMA: SiteNavigationElement      -->
<!-- ═══════════════════════════════════════════ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Main Menu",
  "description": "Primary navigation for GrowthWithTech",
  "itemListElement": [
    { "@type": "SiteNavigationElement", "position": 1, "name": "Home", "url": "https://growthwithtech.com/" },
    { "@type": "SiteNavigationElement", "position": 2, "name": "Services", "url": "https://growthwithtech.com/services" },
    { "@type": "SiteNavigationElement", "position": 3, "name": "Portfolio", "url": "https://growthwithtech.com/portfolio" },
    { "@type": "SiteNavigationElement", "position": 4, "name": "Case Studies", "url": "https://growthwithtech.com/case-studies" },
    { "@type": "SiteNavigationElement", "position": 5, "name": "About", "url": "https://growthwithtech.com/about" },
    { "@type": "SiteNavigationElement", "position": 6, "name": "Contact", "url": "https://growthwithtech.com/contact" }
  ]
}
</script>

<!-- ═══════════════════════════════════════════ -->
<!--  JSON-LD SCHEMA: WebSite + SearchAction    -->
<!-- ═══════════════════════════════════════════ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://growthwithtech.com/#website",
  "url": "https://growthwithtech.com",
  "name": "GrowthWithTech",
  "description": "Senior engineering studio for AI products, web platforms, and growth systems.",
  "publisher": { "@id": "https://growthwithtech.com/#organization" },
  "inLanguage": "en-IN",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://growthwithtech.com/portfolio?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

<% if (_breadcrumbs) { %>
<!-- ═══════════════════════════════════════════ -->
<!--  JSON-LD SCHEMA: BreadcrumbList            -->
<!-- ═══════════════════════════════════════════ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": <%- JSON.stringify(_breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "item": b.url
  }))) %>
}
</script>
<% } %>
