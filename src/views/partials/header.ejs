<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('seo-head') %>
</head>
<body>
<a href="#main-content" style="position:absolute;top:-40px;left:0;background:var(--accent-cyan);color:#000;padding:8px 16px;z-index:99999;border-radius:0 0 8px 0;font-weight:600;text-decoration:none;transition:top 0.2s;" onfocus="this.style.top='0'" onblur="this.style.top='-40px'">Skip to main content</a>
    <header class="global-header">
        <!-- Top Contact Bar -->
        <div class="top-contact-bar" style="background: rgba(0, 0, 0, 0.3); border-bottom: 1px solid rgba(255,255,255,0.02); font-size: 0.75rem; color: var(--text-secondary); padding: 0.5rem 0;">
            <div style="max-width: 1400px; margin: 0 auto; display: flex; justify-content: flex-end; gap: 2rem; padding: 0 1.5rem;">
                <a href="mailto:info@growthwithtech.com" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s;" onmouseover="this.style.color='white'" onmouseout="this.style.color='var(--text-secondary)'">
                    <i class="fas fa-envelope" style="color: var(--accent-cyan);"></i> info@growthwithtech.com
                </a>
                <a href="tel:+919667854160" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s;" onmouseover="this.style.color='white'" onmouseout="this.style.color='var(--text-secondary)'">
                    <i class="fas fa-phone-alt" style="color: var(--accent-cyan);"></i> +91 9667854160
                </a>
            </div>
        </div>

        <!-- Main Navigation -->
        <nav role="navigation" aria-label="Main navigation">
            <div class="nav-container">
                <a href="/" class="logo" style="display: flex; align-items: center;">
                    <img src="/images/growthwithtech.png" alt="GrowthWithTech" class="brand-logo" style="height: 48px; object-fit: contain;">
                </a>
                
                <button class="mobile-menu-btn" aria-label="Toggle menu" onclick="document.querySelector('.nav-pill').classList.toggle('active')">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="nav-pill">
                    <a href="/">Home</a>
                    <a href="/services">Services</a>
                    <a href="/portfolio">Portfolio</a>
                    <a href="/case-studies">Case Studies</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                </div>
                <a href="/contact" class="btn-nav">Start a Project</a>
            </div>
        </nav>
    </header>
