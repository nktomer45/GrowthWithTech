        </div>

        <!-- 4-Column Stats -->
        <div class="grid grid-4" style="max-width: 1000px; margin: 0 auto; gap: 1rem;">
            <div class="reveal card" style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 16px; padding: 2rem 1.5rem; text-align: center; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 1.25rem; margin-bottom: 1rem;"><i class="fas fa-code-branch"></i></div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">6+</div>
                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Years Engineering</div>
            </div>
            <div class="reveal card" style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 16px; padding: 2rem 1.5rem; text-align: center; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 1.25rem; margin-bottom: 1rem;"><i class="fas fa-rocket"></i></div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">25</div>
                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Products Shipped</div>
            </div>
            <div class="reveal card" style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 16px; padding: 2rem 1.5rem; text-align: center; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 1.25rem; margin-bottom: 1rem;"><i class="fas fa-users"></i></div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">15+</div>
                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Clients Served</div>
            </div>
            <div class="reveal card" style="background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 16px; padding: 2rem 1.5rem; text-align: center; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 1.25rem; margin-bottom: 1rem;"><i class="fas fa-robot"></i></div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">5+</div>
                <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">AI Systems Live</div>
            </div>
        </div>
    </section>

    <!-- Philosophy Section -->
