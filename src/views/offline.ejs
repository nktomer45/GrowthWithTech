<%- include('partials/header') %>

<main id="main-content" role="main">
    <section class="section-padding" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center; background: radial-gradient(circle at center, rgba(14, 165, 233, 0.1) 0%, transparent 70%);">
        <div class="container">
            <div class="reveal" style="margin-bottom: 2rem;">
                <div style="font-size: 5rem; color: var(--accent-cyan); margin-bottom: 2rem;">
                    <i class="fas fa-wifi-slash"></i>
                </div>
                <h1 style="font-size: 3.5rem; font-weight: 700; margin-bottom: 1.5rem;">You're currently <span style="background: var(--gradient-tech); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">offline</span></h1>
                <p style="color: var(--text-secondary); font-size: 1.125rem; max-width: 600px; margin: 0 auto 3rem; line-height: 1.6;">
                    It looks like your internet connection is down. Don't worry, you can still browse previously visited pages of GrowthWithTech.
                </p>
                <div style="display: flex; justify-content: center; gap: 1rem;">
                    <button onclick="window.location.reload()" class="btn-nav" style="padding: 0.8rem 2rem; font-size: 1rem; border: none; cursor: pointer;">
                        Try Reconnecting
                    </button>
                    <a href="/" style="padding: 0.8rem 2rem; border-radius: 999px; font-size: 1rem; font-weight: 500; background: rgba(255, 255, 255, 0.5); border: 1px solid var(--border-glass); color: var(--text-primary);">
                        Go Home
                    </a>
                </div>
            </div>
            
            <div class="reveal" style="margin-top: 4rem; padding-top: 4rem; border-top: 1px solid var(--border-glass);">
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem;">Quick Links (Cached):</p>
                <div style="display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap;">
                    <a href="/services" style="color: var(--text-primary); text-decoration: none; font-weight: 500;">Services</a>
                    <a href="/portfolio" style="color: var(--text-primary); text-decoration: none; font-weight: 500;">Portfolio</a>
                    <a href="/about" style="color: var(--text-primary); text-decoration: none; font-weight: 500;">About</a>
                    <a href="/contact" style="color: var(--text-primary); text-decoration: none; font-weight: 500;">Contact</a>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
