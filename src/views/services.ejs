<%- include('partials/header') %>

<main id="main-content" role="main">
    <!-- Hero & Services Grid -->
    <section class="container section-padding">
        <div style="text-align: center; margin-bottom: 4rem;">
            <div style="display: inline-flex; align-items: center; justify-content: center; background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.1); color: var(--accent-cyan); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 1rem; border-radius: 999px; margin-bottom: 1.5rem;">
                Services
            </div>
            <h1 class="reveal" style="font-size: 4rem; font-weight: 700; margin-bottom: 1.5rem; letter-spacing: -0.04em;">Everything you need to <span style="background: var(--gradient-tech); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">ship</span></h1>
            <p class="reveal" style="font-size: 1.125rem; color: var(--text-secondary); max-width: 700px; margin: 0 auto; line-height: 1.6;">A senior team that handles strategy, design, engineering, AI, and growth — without the agency overhead.</p>
        </div>

        <div class="grid grid-2" style="gap: 1.5rem; max-width: 1000px; margin: 0 auto;">
            <% services.forEach(service => { %>
                <div class="card service-card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 20px; display: flex; flex-direction: row; align-items: flex-start; gap: 1.5rem; box-shadow: var(--glass-shadow);">
                    <div class="icon-box" style="margin-bottom: 0 !important; width: 44px; height: 44px; min-width: 44px; background: rgba(8, 145, 178, 0.05); border: 1px solid rgba(8, 145, 178, 0.1);"><i class="fas fa-<%= service.icon %>"></i></div>
                    <div>
                        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-primary);"><%= service.title %></h3>
                        <p style="color: var(--text-secondary); line-height: 1.5; font-size: 0.9rem;"><%= service.description %></p>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>

    <!-- Process Section -->
    <section class="section-padding container">
        <div style="text-align: center; margin-bottom: 4rem;">
            <div style="display: inline-flex; align-items: center; justify-content: center; background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.1); color: var(--accent-cyan); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 1rem; border-radius: 999px; margin-bottom: 1.5rem;">
                How We Work
            </div>
            <h2 class="reveal" style="font-size: 3rem; font-weight: 700; margin-bottom: 1rem;">A <span style="background: var(--gradient-tech); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">disciplined</span> process</h2>
        </div>
        
        <div class="grid grid-4" style="text-align: left; gap: 1.5rem; max-width: 1000px; margin: 0 auto;">
            <div class="card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 20px; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 0.8rem; font-weight: 700; margin-bottom: 0.5rem;">01</div>
                <h4 style="margin-bottom: 0.75rem; color: var(--text-primary); font-size: 1.125rem;">Discover</h4>
                <p style="color: var(--text-secondary); line-height: 1.6; font-size: 0.85rem;">Needs, architecture, success metrics, technical limits.</p>
            </div>
            <div class="card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 20px; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 0.8rem; font-weight: 700; margin-bottom: 0.5rem;">02</div>
                <h4 style="margin-bottom: 0.75rem; color: var(--text-primary); font-size: 1.125rem;">Design</h4>
                <p style="color: var(--text-secondary); line-height: 1.6; font-size: 0.85rem;">Wireframes, prototypes, design system, flows.</p>
            </div>
            <div class="card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 20px; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 0.8rem; font-weight: 700; margin-bottom: 0.5rem;">03</div>
                <h4 style="margin-bottom: 0.75rem; color: var(--text-primary); font-size: 1.125rem;">Build</h4>
                <p style="color: var(--text-secondary); line-height: 1.6; font-size: 0.85rem;">Iterative shipping with weekly demos and metrics.</p>
            </div>
            <div class="card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 20px; box-shadow: var(--glass-shadow);">
                <div style="color: var(--accent-cyan); font-size: 0.8rem; font-weight: 700; margin-bottom: 0.5rem;">04</div>
                <h4 style="margin-bottom: 0.75rem; color: var(--text-primary); font-size: 1.125rem;">Grow</h4>
                <p style="color: var(--text-secondary); line-height: 1.6; font-size: 0.85rem;">Measure, optimize, and scale with real data.</p>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section class="section-padding container">
        <div style="text-align: center; margin-bottom: 4rem;">
            <div style="display: inline-flex; align-items: center; justify-content: center; background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.1); color: var(--accent-cyan); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 1rem; border-radius: 999px; margin-bottom: 1.5rem;">
                Transparent Pricing
            </div>
            <h2 class="reveal" style="font-size: 3rem; font-weight: 700; margin-bottom: 1rem;">Simple, <span style="background: var(--gradient-tech); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">predictable</span> plans</h2>
        </div>
        
        <div class="grid grid-3" style="gap: 1.5rem; max-width: 1000px; margin: 0 auto;">
            <!-- Starter Plan -->
            <div class="card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 20px; box-shadow: var(--glass-shadow); display: flex; flex-direction: column;">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">Starter Website</h3>
                <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">₹9,999</div>
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border-glass); padding-bottom: 1.5rem;">Perfect for new businesses needing a professional online presence.</p>
                <ul style="list-style: none; padding: 0; margin-bottom: 2rem; flex-grow: 1;">
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Responsive Design (up to 5 pages)</li>
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Basic SEO Setup</li>
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Contact Form Integration</li>
                </ul>
                <a href="/contact?plan=starter" class="btn-nav" style="text-align: center; display: block; padding: 0.8rem; border-radius: 8px;">Get Started</a>
            </div>
            
            <!-- Professional Plan -->
            <div class="card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 2px solid var(--accent-cyan); border-radius: 20px; box-shadow: 0 10px 30px rgba(8, 145, 178, 0.15); display: flex; flex-direction: column; transform: scale(1.05); z-index: 1;">
                <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--gradient-btn); color: white; padding: 0.2rem 1rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600;">MOST POPULAR</div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">Growth Package</h3>
                <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">₹19,999</div>
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border-glass); padding-bottom: 1.5rem;">For growing businesses ready to generate leads and scale.</p>
                <ul style="list-style: none; padding: 0; margin-bottom: 2rem; flex-grow: 1;">
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Custom UI/UX (up to 10 pages)</li>
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Advanced Technical SEO</li>
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Chatbot / WhatsApp Integration</li>
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> CMS & Analytics Setup</li>
                </ul>
                <a href="/contact?plan=growth" class="btn-nav" style="text-align: center; display: block; padding: 0.8rem; border-radius: 8px;">Get Started</a>
            </div>
            
            <!-- Enterprise Plan -->
            <div class="card reveal" style="padding: 2rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); border-radius: 20px; box-shadow: var(--glass-shadow); display: flex; flex-direction: column;">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">AI & Custom App</h3>
                <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">Custom</div>
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border-glass); padding-bottom: 1.5rem;">Complex web applications, AI agents, and enterprise automations.</p>
                <ul style="list-style: none; padding: 0; margin-bottom: 2rem; flex-grow: 1;">
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Full-Stack Architecture</li>
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Custom AI / LLM Integrations</li>
                    <li style="margin-bottom: 0.8rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;"><i class="fas fa-check" style="color: var(--accent-cyan);"></i> Scalable Cloud Infrastructure</li>
                </ul>
                <a href="/contact?plan=custom" style="text-align: center; display: block; padding: 0.8rem; border-radius: 8px; border: 1px solid var(--border-glass); color: var(--text-primary); text-decoration: none; font-weight: 600;">Talk to Sales</a>
            </div>
        </div>
    </section>

    <!-- Capabilities Section -->
    <section class="section-padding container" style="margin-bottom: 6rem;">
        <div style="text-align: center; margin-bottom: 4rem;">
            <div style="display: inline-flex; align-items: center; justify-content: center; background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.1); color: var(--accent-cyan); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 1rem; border-radius: 999px; margin-bottom: 1.5rem;">
                Capabilities
            </div>
            <h2 class="reveal" style="font-size: 3rem; font-weight: 700; margin-bottom: 1rem;">What's <span style="background: var(--gradient-tech); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">included</span></h2>
        </div>
        
        <div class="grid grid-2" style="gap: 1rem; max-width: 800px; margin: 0 auto 4rem;">
            <div class="reveal" style="display: flex; align-items: center; gap: 1rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.25rem 1.5rem; border-radius: 12px; box-shadow: var(--glass-shadow);">
                <i class="fas fa-check" style="color: var(--accent-cyan); font-size: 0.8rem;"></i>
                <span style="color: var(--text-secondary); font-size: 0.95rem;">Discovery, scoping & technical architecture</span>
            </div>
            <div class="reveal" style="display: flex; align-items: center; gap: 1rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.25rem 1.5rem; border-radius: 12px; box-shadow: var(--glass-shadow);">
                <i class="fas fa-check" style="color: var(--accent-cyan); font-size: 0.8rem;"></i>
                <span style="color: var(--text-secondary); font-size: 0.95rem;">Design systems and component libraries</span>
            </div>
            <div class="reveal" style="display: flex; align-items: center; gap: 1rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.25rem 1.5rem; border-radius: 12px; box-shadow: var(--glass-shadow);">
                <i class="fas fa-check" style="color: var(--accent-cyan); font-size: 0.8rem;"></i>
                <span style="color: var(--text-secondary); font-size: 0.95rem;">Performance budgets, Core Web Vitals optimizations</span>
            </div>
            <div class="reveal" style="display: flex; align-items: center; gap: 1rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.25rem 1.5rem; border-radius: 12px; box-shadow: var(--glass-shadow);">
                <i class="fas fa-check" style="color: var(--accent-cyan); font-size: 0.8rem;"></i>
                <span style="color: var(--text-secondary); font-size: 0.95rem;">APIs, automations, and agentic workflows built</span>
            </div>
            <div class="reveal" style="display: flex; align-items: center; gap: 1rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.25rem 1.5rem; border-radius: 12px; box-shadow: var(--glass-shadow);">
                <i class="fas fa-check" style="color: var(--accent-cyan); font-size: 0.8rem;"></i>
                <span style="color: var(--text-secondary); font-size: 0.95rem;">Analytics, attribution, and growth experimentation</span>
            </div>
            <div class="reveal" style="display: flex; align-items: center; gap: 1rem; background: var(--bg-card); backdrop-filter: var(--glass-blur); border: 1px solid var(--border-glass); padding: 1.25rem 1.5rem; border-radius: 12px; box-shadow: var(--glass-shadow);">
                <i class="fas fa-check" style="color: var(--accent-cyan); font-size: 0.8rem;"></i>
                <span style="color: var(--text-secondary); font-size: 0.95rem;">Robust CI/CD and QA systems</span>
            </div>
        </div>

        <div style="text-align: center;">
            <a href="/contact" class="btn-nav" style="padding: 0.8rem 2.5rem; font-size: 1rem; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;">Discuss your project <i class="fas fa-arrow-right" style="transform: rotate(-45deg);"></i></a>
        </div>
    </section>
</main>

<style>
@keyframes spin { from {transform: rotate(0deg);} to {transform: rotate(360deg);} }
</style>

<!-- FAQ Schema for AI & Search Engines -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What services does GrowthWithTech offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GrowthWithTech offers senior engineering services including Web Development (React, TypeScript, Node.js), Agentic AI solutions, Custom Chatbots, SEO, Digital Marketing, and Paid Ads management."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide custom AI chatbot solutions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we specialize in RAG-powered custom AI chatbots and autonomous agentic workflows using LangGraph, OpenAI, and Gemini."
      }
    },
    {
      "@type": "Question",
      "name": "Where is GrowthWithTech located?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GrowthWithTech is headquartered in Noida, India, at Gaur City Mall, serving clients worldwide."
      }
    }
  ]
}
</script>

<%- include('partials/footer') %>
