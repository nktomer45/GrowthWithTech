<%- include('partials/header') %>

<main id="main-content" role="main">
    <section class="container section-padding">
        <div style="text-align: center; margin-bottom: 6rem;">
            <div class="hero-badge reveal" style="margin: 0 auto 2rem; display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(14, 165, 233, 0.05);
    border: 1px solid rgba(14, 165, 233, 0.1);
    color: var(--accent-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;">CASE STUDIES</div>
            <h1 class="reveal" style="font-size: 72px; font-weight: 700; line-height: 1.1; letter-spacing: -0.05em; margin-bottom: 1.5rem;">Results that speak for <span style="background: var(--gradient-tech); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">themselves</span></h1>
            <p class="reveal" style="font-size: 1.25rem; color: var(--text-secondary); max-width: 800px; margin: 0 auto;">In-depth breakdowns of how we solve complex engineering and growth challenges for our clients.</p>
        </div>
        
        <div class="portfolio-grid" style="grid-template-columns: 1fr; gap: 4rem;">
            <% projects.slice(0, 3).forEach(project => { %>
                <div class="card reveal case-study-card" style="padding: 0; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; border-radius: 16px; border: 1px solid var(--border-glass);">
                    <div style="height: 500px;">
                        <img src="<%= project.image %>" alt="<%= project.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div style="padding: 4rem; display: flex; flex-direction: column; justify-content: center;">
                        <span style="font-size: 0.8rem; font-weight: 600; color: var(--accent-cyan); display: block; margin-bottom: 1rem;"><%= project.category %></span>
                        <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem;"><%= project.title %></h2>
                        <p style="color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem; font-size: 1.1rem;"><%= project.description %></p>
                        
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 3rem;">
                            <% project.metrics.forEach(m => { %>
                                <div>
                                    <p style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary);"><%= m.value %></p>
                                    <p style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;"><%= m.label %></p>
                                </div>
                            <% }) %>
                        </div>
                        
                        <a href="/case-study/<%= project.id %>" class="btn-nav" style="width: fit-content; padding: 0.8rem 2rem;">Read Full Case Study</a>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
